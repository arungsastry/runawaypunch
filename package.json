{
  "name": "runawaypunch",
  "version": "1.0.0",
  "type": "module",
  "description": "Animation-based web game built with Solid.js and Vite",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "deploy": "vite build && gh-pages -d dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "solid-js": "^1.8.11"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "gh-pages": "^6.3.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-solid": "^2.8.2"
  }
}
